# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server only

# LiveKit Cloud: Settings -> API keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret            # secret, server only

# Anthropic (Ask a senior): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...                        # secret, server only
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=20

# Optional: set to "off" to hide college-email code sign-in (Google only) until your email sender works
NEXT_PUBLIC_EMAIL_CODES=on

# Policy pages (Privacy, Terms, Guidelines). Shown publicly.
NEXT_PUBLIC_LEGAL_OPERATOR=Your full name or company name
NEXT_PUBLIC_LEGAL_CITY=City, State
NEXT_PUBLIC_CONTACT_EMAIL=hello@yourdomain.in
NEXT_PUBLIC_GRIEVANCE_OFFICER=Grievance Officer full name
NEXT_PUBLIC_GRIEVANCE_EMAIL=grievance@yourdomain.in

# Student verification (college email codes via Brevo SMTP) and the daily photo clean-up
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Den <you@gmail.com>
CRON_SECRET=
