# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # secret, server only

# LiveKit Cloud: Settings -> API keys
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-key
LIVEKIT_API_SECRET=your-livekit-secret            # secret, server only

# Anthropic (Ask a senior): console.anthropic.com -> API keys
ANTHROPIC_API_KEY=sk-ant-...                        # secret, server only
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_DAILY_LIMIT=20
